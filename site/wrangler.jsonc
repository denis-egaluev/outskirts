{
  "name": "outskirts-site",
  "compatibility_date": "2026-11-01",
  "build": { "command": "npm run build" },
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "invocation_logs": false }
  }
}
